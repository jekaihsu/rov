{
  "name": "rov01-simulator-desktop",
  "productName": "ROV-01 Simulator",
  "version": "0.3.0",
  "private": true,
  "description": "ROV-01 Underwater Inspection & Pilot Training Simulator desktop shell (Steam + B2B standalone).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-shot=../wave2_electron_shell.png",
    "build:win64-steam": "node package_steam_depot.js"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.3.1"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "build": {
    "appId": "com.yongxiang.rov01simulator",
    "productName": "ROV-01 Simulator",
    "win": {
      "target": [
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "extraResources": [
      "../box_run/viewer/**",
      "../box_run/rov01sim/**",
      "steam_app_id.txt",
      "steamworks_config/**"
    ]
  }
}
