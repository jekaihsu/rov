  "strings": {
    "zh-TW": {
      "supervisor": "林督導",
      "tender": "阿禾",
      "brief": "風場給我們一個潮窗。先看導管架外側的陽極塊，不穿斜撐。流一旦超出能控制的程度就停工。",
      "task_1": "作業一｜迎流接近：完成第一處陽極巡檢",
      "task_1_brief": "推桿給的是推力。先在外側試小幅修正，定深不會替你守住水平位置。",
      "task_1_cable": "我把多餘的線留在甲板，水裡那段也會吃你的推力。",
      "task_1_poll.hint": "前往第一站，面向陽極塊、低速穩定三秒後拍照；無底鎖不要依賴定點。",
      "task_1_report": "第一處有影像了。小修正比來回打滿桿省事。",
      "task_2": "作業二｜抗流定點：完成第二處陽極巡檢",
      "task_2_brief": "看目標有沒有在畫面裡走。有效底鎖才談定點，守不住就退出。",
      "task_2_cable": "我不拿收線替你煞車。你報要退，我就配合。",
      "task_2_poll.hint": "到第二站面向結構，持續低速三秒拍照；推力飽和時退到可控制水域。",
      "task_2_report": "站穩才拍得到。照片只算外觀，不是陰極保護讀值。",
      "task_3": "作業三｜外側換面：完成第三處陽極巡檢",
      "task_3_brief": "沿外側換面。若纜線卡住，先回頭找卡點，別往反方向拉更緊。",
      "task_3_cable": "我盯張力。你說停，我就停，不跟那根斜撐拔河。",
      "task_3_poll.hint": "沿外圍到第三站，面向陽極穩定拍照；不要從導管架內部抄近路。",
      "task_3_report": "這趟沒有必要為一張照片鑽進去。保住退路，才有下一趟。",
      "done": "研究站還有一份小案子。帶上機械臂載具，明天去礁區。",
      "abort": "停工。這趟不交合格報告。從章節面板重開本章，先確認退路和剩餘時間。",
      "abort_goal": "本趟中止：從章節面板重開本章；不計完成、不發獎勵。",
      "abort_hold.hint": "從章節面板重開本章。"
    }
  }
}
