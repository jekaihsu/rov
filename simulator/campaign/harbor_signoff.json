  "strings": {
    "zh-TW": {
      "supervisor": "林岑",
      "tender": "周楷",
      "client": "葉理",
      "deck": "方晴",
      "mentor": "馬力",
      "brief": "交班前我要檔案。窗口短。R-1，只打三點異常。",
      "task_1": "作業一｜異常一：同角度複查",
      "task_1_brief": "同角度。對上次那張。",
      "task_1_cable": "線短放。濁水別繞遠。",
      "task_1_poll.hint": "依第一站提示穩定拍照；保持同角度，留出退出空間。",
      "task_1_report": "一號存了。",
      "task_2": "作業二｜異常二：裂縫是否惡化",
      "task_2_brief": "二號。裂是否變長。",
      "task_2_cable": "我先理好甲板的線。張力上升先停下。",
      "task_2_poll.hint": "到第二站穩定拍照。張力上升先停下評估，沿來路返回卡點，不盲拉。",
      "task_2_report": "有惡化。記清楚。",
      "task_3": "作業三｜異常三：交班照片",
      "task_3_brief": "最後這張要讓下一班看得懂。風起來了。",
      "task_3_cable": "收到。今天的線沒有變麻花。",
      "task_3_poll.hint": "完成第三站穩定拍照；確認各站完成標示，再按無線電繼續。",
      "task_3_report": "三點齊。回收。",
      "done": "檔案到。我去交班。見習結束考核過。準時不代表乾淨。你自己知。",
      "abort": "中止。窗不夠。寫待複查。人機優先。",
      "abort_goal": "本趟中止：從章節面板重開本章；不計完成、不發獎勵。",
      "abort_hold.hint": "從章節面板重開本章。"
    }
  }
