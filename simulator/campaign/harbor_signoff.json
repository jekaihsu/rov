  "strings": {
    "zh-TW": {
      "supervisor": "林督導",
      "tender": "阿禾",
      "brief": "交班前再看一次。照片要能讓下一班找到同一處，今天練貼近結構與留退路。",
      "task_1": "作業一｜樁面定位：完成第一站",
      "task_1_brief": "面對樁往下看，別一邊轉一邊掉深度。",
      "task_1_cable": "線在你後面。先看清這一面，再換下一面。",
      "task_1_poll.hint": "依第一站提示穩定三秒拍照；保持面對樁，留出退出空間。",
      "task_1_report": "位置對上了。這張留作全景。",
      "task_2": "作業二｜樁腳複查：完成第二站",
      "task_2_brief": "新刮痕在下面。先拍位置，再拍細節，不碰樁。",
      "task_2_cable": "我先理好甲板的線。你別繞滿一圈又接著繞。",
      "task_2_poll.hint": "到第二站穩定拍照。張力上升先停下評估，沿來路返回卡點，不盲拉。",
      "task_2_report": "痕跡是一圈磨漆，沒有足夠證據說是裂痕。",
      "task_3": "作業三｜交接照片：完成第三站",
      "task_3_brief": "最後這張要讓夜班看得懂。把鄰近結構也帶進去。",
      "task_3_cable": "收到。今天的線沒有變麻花，我也有功勞吧。",
      "task_3_poll.hint": "完成第三站穩定拍照；確認各站完成標示，再按無線電繼續。",
      "task_3_report": "有。日誌寫你一筆。交班不是把機器交出去就算完。",
      "done": "港灣案結了，作業載具也能部署了。下一趟去離岸，別把平潮當成保證。",
      "abort": "停工。這趟不交合格報告。從章節面板重開本章，先確認退路和剩餘時間。",
      "abort_goal": "本趟中止：從章節面板重開本章；不計完成、不發獎勵。",
      "abort_hold.hint": "從章節面板重開本章。"
    }
  }
}
