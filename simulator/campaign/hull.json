  "strings": {
    "zh-TW": {
      "brief.text": "船主說昨晚靠泊時擦了一下。船底下更暗，別貼太近。",
      "brief.speaker": "林督導",
      "depth_goal.text": "潛到龍骨附近，深度超過八公尺",
      "depth_line.text": "先沉下去。船底像天花板，你會想抬頭看——別急。",
      "depth_line.speaker": "林督導",
      "depth.hint": "下潛至深度大於 8 m",
      "light_line.text": "能見度掉了。開燈，再往前挪。",
      "light_line.speaker": "林督導",
      "light.hint": "L / 燈光鍵",
      "survey_goal.text": "依巡檢站點穩定懸停並拍照",
      "cable.text": "線在船緣可能卡住。看不見就停。照片不清楚可以重拍，船殼不能拿來煞車。",
      "cable.speaker": "阿禾",
      "survey.hint": "前往 HUD 巡檢站點，穩定三秒後拍照",
      "tension_line.text": "張力還好。慢慢退，別在龍骨轉彎處硬拉。",
      "tension_line.speaker": "阿禾",
      "done.text": "照片齊了。阿禾，收線吧。今晚有飯吃了。",
      "done.speaker": "林督導"
    }
  }
