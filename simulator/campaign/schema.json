{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "scenario",
    "mode",
    "category",
    "order",
    "nodes",
    "strings"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "free_explore",
        "inspection_coop",
        "scenario_training",
        "expedition"
      ]
    },
    "category": {
      "description": "story chapters form the auto-started campaign; incidents are launched explicitly; the prelude (cold open) is launched by the new-game flow only.",
      "enum": [
        "prelude",
        "story",
        "incident",
        "course"
      ]
    },
    "order": {
      "description": "Position inside the category; lower runs first.",
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "dialogue",
              "wait",
              "objective",
              "hint",
              "branch",
              "reward",
              "checkpoint",
              "environment",
              "spawn",
              "remove"
            ]
          },
          "voice": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": "object",
            "required": [
              "path",
              "op",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "lt",
                  "gt"
                ]
              },
              "value": {}
            }
          },
          "speaker_key": {
            "type": "string"
          },
          "text_key": {
            "type": "string"
          },
          "hint_key": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reward": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "visibility_m": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "point": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "dialogue"
                }
              }
            },
            "then": {
              "required": [
                "text_key",
                "speaker_key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "wait"
                }
              }
            },
            "then": {
              "required": [
                "condition"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "branch"
                }
              }
            },
            "then": {
              "required": [
                "condition",
                "target"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "objective"
                }
              }
            },
            "then": {
              "required": [
                "text_key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "hint"
                }
              }
            },
            "then": {
              "required": [
                "text_key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reward"
                }
              }
            },
            "then": {
              "required": [
                "reward"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "environment"
                }
              }
            },
            "then": {
              "required": [
                "visibility_m"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "spawn"
                }
              }
            },
            "then": {
              "required": [
                "object_id",
                "label",
                "point"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remove"
                }
              }
            },
            "then": {
              "required": [
                "object_id"
              ]
            }
          }
        ]
      }
    },
    "strings": {
      "type": "object",
      "required": [
        "zh-TW"
      ],
      "properties": {
        "zh-TW": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "next",
          "limit",
          "hud"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "idle": {
            "type": "number",
            "minimum": 0
          },
          "radio": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "reminder": {
            "type": "string"
          },
          "hud": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "condition": {
            "$ref": "#/properties/nodes/items/properties/condition"
          },
          "target": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "card": {
            "type": "string"
          },
          "cue": {
            "type": "string"
          },
          "black": {
            "type": "boolean"
          },
          "storyboard": {
            "description": "Presentation-only beat. Play this storyboard ID, then follow next on finish or skip.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "cinematic": {
            "type": "boolean"
          },
          "location": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
