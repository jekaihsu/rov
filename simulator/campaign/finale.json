  "strings": {
    "zh-TW": {
      "brief.text": "潮汐窗口只剩一輪。夜間回收那箱未登記貨，順便把能拍的線索帶走。",
      "brief.speaker": "林督導",
      "window_line.text": "甲板燈關一半。我聽得見你呼吸，別跟我比緊張。",
      "window_line.speaker": "阿禾",
      "dive_goal.text": "夜間下潛至殘骸附近",
      "dive.hint": "下潛至深度大於 15 m，並開燈",
      "light.hint": "L / 燈光鍵",
      "recover_line.text": "證物箱在艙口外側。夾穩，慢慢上。",
      "recover_line.speaker": "林督導",
      "recover_goal.text": "用機械臂回收證物箱並帶回淺處放下",
      "grasp_case.hint": "靠近證物箱，閉合夾爪",
      "surface_line.text": "線收好了。上來，吊籃在右舷。",
      "surface_line.speaker": "阿禾",
      "near_surface.hint": "帶著證物箱上浮至深度小於 4 m",
      "release_case.hint": "張開夾爪，放下證物箱",
      "clue_line.text": "若還看得見名牌或本子，多拍幾張。拍不夠，故事就只剩半截。",
      "clue_line.speaker": "林督導",
      "clue_goal.text": "拍攝現場線索；完整調查需超過三張照片",
      "clue_photos.hint": "P / 拍照鍵，至少一張；三張以上解鎖完整結局",
      "ending_partial.text": "箱是帶上來了，但線索不夠。委託人只拿到半份真相，我們也只能收下半份尾款。",
      "ending_partial.speaker": "林督導",
      "ending_full.text": "名牌、維修本、箱體編號對得起來。這船不是天災——有人改過壓艙。報告會寫清楚。",
      "ending_full.speaker": "林督導",
      "wrap.text": "收工。潮間帶工作隊又活過一季。下回水池見，新人。",
      "wrap.speaker": "阿禾"
    }
  }
