  "strings": {
    "zh-TW": {
      "brief.text": "例行沉船外觀調查。水深三十，能見度爛。桅桿還在，別去纏。",
      "brief.speaker": "林督導",
      "approach_goal.text": "下潛接近殘骸作業深度",
      "approach_line.text": "慢慢沉。泥一揚，什麼都沒了。",
      "approach_line.speaker": "林督導",
      "approach_depth.hint": "下潛至深度大於 12 m",
      "light_line.text": "開燈。羅盤靠近鋼殼會飄，別死盯航向。",
      "light_line.speaker": "林督導",
      "light.hint": "L / 燈光鍵",
      "survey_goal.text": "繞殘骸完成巡檢站點拍照",
      "cable.text": "我把線收短。你繞船一圈，轉彎前先抬頭看桅。",
      "cable.speaker": "阿禾",
      "survey.hint": "前往 HUD 巡檢站點，穩定三秒後拍照",
      "mystery_line.text": "等一下——艙口旁邊那箱不在委託清單上。多拍幾張。",
      "mystery_line.speaker": "林督導",
      "clue_goal.text": "補拍未登記箱體與周邊，總照片數超過四張",
      "clue_photo.hint": "P / 拍照鍵，直到照片數大於 4",
      "tension_line.text": "線還在。別進艙，圍板會咬死纜。",
      "tension_line.speaker": "阿禾",
      "safe_tether.hint": "確認纜線未斷，保持在艙外",
      "done.text": "清單上沒這箱。壓艙紀錄也對不上。今晚潮汐窗口短，我們得再潛一次。",
      "done.speaker": "林督導"
    }
  }
