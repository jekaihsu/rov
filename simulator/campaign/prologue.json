  "strings": {
    "zh-TW": {
      "callsign.text": "向潮－指揮呼叫 R-1。",
      "callsign.speaker": "林岑",
      "welcome.text": "今天池裡認識搭檔。先檢查。",
      "welcome.speaker": "林岑",
      "deck_ready.text": "甲板淨空。尾板就緒。",
      "deck_ready.speaker": "方晴",
      "tender_ready.text": "纜手就位。線我看著。",
      "tender_ready.speaker": "周楷",
      "predive.text": "下水前先確認密封、接頭與配平。入水且人員離開尾板再解鎖。",
      "predive.speaker": "林岑",
      "enter_water.text": "入水。人離甲板再解鎖。",
      "enter_water.speaker": "林岑",
      "unlock.hint": "按解鎖鍵解除馬達鎖定（鍵盤或手把）",
      "move.text": "很好。慢慢來，先往前。",
      "move.speaker": "林岑",
      "move_前.hint": "向前移動，直到機體真的動起來",
      "move_後.hint": "向後移動，直到機體真的動起來",
      "move_右.hint": "向右移動，直到機體真的動起來",
      "move_左.hint": "向左移動，直到機體真的動起來",
      "move_下.hint": "向下移動，直到機體真的動起來",
      "move_上.hint": "向上移動，直到機體真的動起來",
      "depth_line.text": "停一下。把定深打開。",
      "depth_line.speaker": "林岑",
      "depth.hint": "按定深鍵開啟定深",
      "depth_ok.text": "手可以鬆一點了。",
      "depth_ok.speaker": "林岑",
      "light_line.text": "水裡看不清就先開燈。",
      "light_line.speaker": "林岑",
      "light.hint": "按燈光鍵開燈",
      "photo_line.text": "周楷，把這張留著。",
      "photo_line.speaker": "林岑",
      "photo.hint": "按拍照鍵拍照",
      "photo_ack.text": "收到。新人第一張。",
      "photo_ack.speaker": "周楷",
      "end.text": "收工。程序過了。",
      "end.speaker": "林岑",
      "end_tender.text": "線收好。明天港外見。",
      "end_tender.speaker": "周楷",
      "end_senior.text": "回來。泡麵偏鹹，將就。",
      "end_senior.speaker": "馬力"
    }
  },
