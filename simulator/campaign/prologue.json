  "strings": {
    "zh-TW": {
      "welcome.text": "船老了，人可不能馬虎。我是林岑。今天先在池裡認識你的搭檔。",
      "welcome.speaker": "林督導",
      "unlock.hint": "按解鎖鍵解除馬達鎖定（鍵盤或手把）",
      "move.text": "很好。慢慢來，先往前，再退回來。",
      "move.speaker": "林督導",
      "move_前.hint": "向前移動，直到機體真的動起來",
      "move_後.hint": "向後移動，直到機體真的動起來",
      "move_右.hint": "向右移動，直到機體真的動起來",
      "move_左.hint": "向左移動，直到機體真的動起來",
      "move_下.hint": "向下移動，直到機體真的動起來",
      "move_上.hint": "向上移動，直到機體真的動起來",
      "depth_line.text": "停一下。把定深打開，讓手鬆一口氣。",
      "depth_line.speaker": "林督導",
      "depth.hint": "按定深鍵開啟定深",
      "light_line.text": "水裡看不清，別急著往前。先開燈。",
      "light_line.speaker": "林督導",
      "light.hint": "按燈光鍵開燈",
      "photo_line.text": "阿禾，把這張留著。這是新人的第一張水下照。",
      "photo_line.speaker": "林督導",
      "photo.hint": "按拍照鍵拍照",
      "end.text": "收工。明天去港裡，船主等著我們查樁和船殼。",
      "end.speaker": "阿禾",
      "predive.text": "下水前先確認密封、接頭與配平。完整作業流程可在主選單開啟；入水且人員離開才解鎖，回收先上鎖。上電順序、提示音與燈號暫定，待實測。",
      "predive.speaker": "林督導"
    }
  }
