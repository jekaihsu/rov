  "strings": {
    "zh-TW": {
      "brief.text": "研究單位要礁區紀錄。換有機械臂的那台，離珊瑚遠一點，推進器別攪底。",
      "brief.speaker": "林督導",
      "eco_goal.text": "拍攝礁區生態，至少三張可用照片",
      "eco_line.text": "魚會自己游進畫面。你負責別撞上去。",
      "eco_line.speaker": "林督導",
      "eco_photos.hint": "P / 拍照鍵，直到照片數大於 3",
      "depth_line.text": "往觀測帶再沉一點。舊儀器掉在西側砂地。",
      "depth_line.speaker": "阿禾",
      "work_depth.hint": "下潛至深度大於 6 m",
      "recover_line.text": "看到那顆黃殼了嗎？夾穩，別夾珊瑚。",
      "recover_line.speaker": "林督導",
      "recover_goal.text": "用機械臂夾起遺失的觀測儀並帶回淺處",
      "grasp_sensor.hint": "靠近遺失觀測儀，閉合夾爪",
      "basket_line.text": "往上帶。甲板吊籃在水面附近，鬆開就行。",
      "basket_line.speaker": "阿禾",
      "near_surface.hint": "帶著觀測儀上浮至深度小於 3 m",
      "release_sensor.hint": "張開夾爪，放下觀測儀",
      "deploy_line.text": "新溫度計在你前方。夾起來，放到更深的砂地上。",
      "deploy_line.speaker": "林督導",
      "deploy_goal.text": "夾起新溫度計，部署到約八公尺深後放開",
      "grasp_logger.hint": "靠近新溫度計，閉合夾爪",
      "place_depth.hint": "帶著溫度計下潛至深度大於 8 m",
      "release_logger.hint": "張開夾爪，放下溫度計",
      "done.text": "回收、部署都有了。研究那邊會謝我們——用發票的那種謝。",
      "done.speaker": "阿禾"
    }
  }
}
