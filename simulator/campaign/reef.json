  "strings": {
    "zh-TW": {
      "supervisor": "林督導",
      "tender": "阿禾",
      "brief": "研究站要換觀測儀。先在章節面板部署已解鎖的作業載具，再開始本章。抓手只搬小件，不拿來吊重物。",
      "task_1": "作業一｜生態基準照（預留五至十分鐘）：取得一筆有效生態觀察",
      "biology": "先留一張環境基準。與生物保持距離，別為湊近照把底泥吹起來。",
      "biology_cable": "我把線留在外側。你顧鏡頭，也幫底下那些住戶留點空間。",
      "biology_wait.hint": "用機載視角拍攝可辨識的生物，確認觀察紀錄已收錄；普通照片數不算。",
      "task_2": "作業二｜回收舊器材（預留五至十五分鐘）：完成一份海底物件回收合約",
      "recover": "開啟海底物件回收合約。先拍原位，再夾取，送到指定交接點才放開。",
      "recover_cable": "我守著回程。夾住先別衝，看看東西是不是跟著走。",
      "recover_wait.hint": "先接回收合約：原位照片、機械臂夾取、運送、放開穩定兩秒。請勿先接其他合約。",
      "task_3": "作業三｜部署觀測儀（預留五至十五分鐘）：完成一份觀測儀部署合約",
      "deploy": "再開部署合約。放到指定位置，等它穩住，再拍完工照。不要把珊瑚當底座。",
      "deploy_cable": "放好了也別急著走。我想看它站穩，你大概也想。",
      "deploy_wait.hint": "回收完成後再接部署合約；夾取、搬運、放開穩定兩秒，最後拍攝部署照片。",
      "done": "兩件器材交接完成。研究站在舊影像裡找到殘骸輪廓，要請我們再看一眼。"
    }
  }
}
