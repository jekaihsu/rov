<?xml version="1.0"?>
<package format="3">
  <name>rov_sim_bridge</name><version>0.1.0</version>
  <description>Simulator extension: ROS 2 bridge over existing simulator protocols.</description>
  <maintainer email="maintainers@example.com">ROV SI team</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav_msgs</exec_depend>
