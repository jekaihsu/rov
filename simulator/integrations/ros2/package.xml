  <exec_depend>tf2_ros</exec_depend><exec_depend>python3-websocket</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
