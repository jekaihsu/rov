{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROV Solution YX work orders (viewer/career/contracts.json)",
  "type": "object",
  "required": ["clients", "jobs", "chapters", "contracts"],
  "additionalProperties": false,
  "properties": {
    "note": {"type": "string"},
    "clients": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z_]{1,32}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {"label": {"type": "string", "minLength": 1}}
      }
    },
    "jobs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z_]{1,32}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "scenario": {"type": "string"}
        }
      }
    },
    "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "range": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "condition": {
      "type": "object",
      "required": ["path", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "op": {"enum": ["eq", "gt", "lt"]},
        "value": {}
      }
    },
    "deliverable": {
      "type": "object",
      "required": ["id", "kind", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["state", "checkpoint", "station_keep", "inspect", "photo", "measure", "probe", "confirm",
          "surface", "lift"]},
        "label": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "point": {"$ref": "#/$defs/point"},
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "hold_s": {"type": "number", "minimum": 0},
        "standoff": {"$ref": "#/$defs/range"},
        "condition": {"$ref": "#/$defs/condition"},
        "equipment": {"$ref": "#/$defs/id"},
        "reading": {"type": "string"},
        "after": {"$ref": "#/$defs/id"},
        "object_kind": {"type": "string", "pattern": "^[a-z_]{1,32}$"},
        "below": {"type": "number", "minimum": 0},
        "count": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["checkpoint", "station_keep", "inspect", "photo", "measure", "probe",
            "surface"]}}},
          "then": {"required": ["point"]}
        },
        {"if": {"properties": {"kind": {"const": "state"}}}, "then": {"required": ["condition"]}},
        {"if": {"properties": {"kind": {"enum": ["measure", "probe"]}}}, "then": {"required": ["equipment", "reading"]}},
        {"if": {"properties": {"kind": {"const": "photo"}}}, "then": {"required": ["standoff"]}},
        {"if": {"properties": {"kind": {"const": "lift"}}}, "then": {"required": ["object_kind", "below"]}}
      ]
    },
    "hazard": {
      "type": "object",
      "required": ["id", "label", "point", "radius", "until", "points"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "point": {"$ref": "#/$defs/point"},
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "until": {"$ref": "#/$defs/id"},
        "points": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "contract": {
      "type": "object",
      "required": ["id", "chapter", "order", "title", "client", "clientName", "job", "scenario", "runtime", "vehicles",
        "licence", "pay", "summary", "brief", "deliverables"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "chapter": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "client": {"type": "string", "pattern": "^[a-z_]{1,32}$"},
        "clientName": {"type": "string", "minLength": 1},
        "job": {"type": "string", "pattern": "^[a-z_]{1,32}$"},
        "scenario": {"type": "string", "minLength": 1},
        "launchScenario": {"type": "string", "minLength": 1},
        "runtime": {"enum": ["deliverables", "chapter"]},
        "campaignChapter": {"$ref": "#/$defs/id"},
        "vehicles": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["x1", "bluerov2_heavy", "falcon"]}},
        "licence": {"$ref": "#/$defs/id"},
        "equipment": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "minReputation": {"type": "integer", "minimum": 0},
        "pay": {"type": "integer", "minimum": 0},
        "reputation": {"type": "integer", "minimum": 0},
        "exam": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {"grants": {"$ref": "#/$defs/id"}, "endorsement": {"$ref": "#/$defs/id"}},
          "minProperties": 1
        },
        "optional": {"type": "boolean"},
        "partial": {"type": "number", "minimum": 0, "maximum": 1},
        "provisional": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1},
        "brief": {"type": "string", "minLength": 1},
        "radio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speaker": {"type": "string"},
            "start": {"type": "string"},
            "done": {"type": "string"},
            "partial": {"type": "string"},
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "speaker", "text"],
                "properties": {
                  "when": {"type": "string", "minLength": 1},
                  "speaker": {"type": "string", "minLength": 1},
                  "text": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "conditions": {"type": "string"},
        "currentKn": {"type": "number", "minimum": 0},
        "deliverables": {"type": "array", "items": {"$ref": "#/$defs/deliverable"}},
        "hazards": {"type": "array", "items": {"$ref": "#/$defs/hazard"}}
      },
      "allOf": [
        {"if": {"properties": {"runtime": {"const": "chapter"}}}, "then": {"required": ["campaignChapter"]}},
        {"if": {"properties": {"runtime": {"const": "deliverables"}}},
          "then": {"properties": {"deliverables": {"minItems": 1}}}}
      ]
    }
  }
}
