{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROV Solution YX equipment department (viewer/career/equipment.json)",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "note": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "price", "licence", "vehicles", "block", "use"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
          "kind": {"enum": ["equipment", "cosmetic"]},
          "label": {"type": "string", "minLength": 1},
          "price": {"type": "integer", "minimum": 0},
          "licence": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
          "vehicles": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["x1", "bluerov2_heavy", "falcon"]}},
          "block": {"type": "boolean"},
          "use": {"type": "string", "minLength": 1},
          "unlocks": {"type": "string"},
          "sticker": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "cosmetic"}}},
            "then": {"required": ["sticker"], "properties": {"block": {"const": false}}}},
          {"if": {"properties": {"kind": {"const": "equipment"}}}, "then": {"required": ["unlocks"]}}
        ]
      }
    }
  }
}
