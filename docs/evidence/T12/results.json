        "type": "dialogue",
        "voice": null,
        "text_key": "move.text",
        "speaker_key": "move.speaker",
        "text": "很好。慢慢來，先往前，再退回來。",
        "speaker": "林督導"
      },
      {
        "id": "depth_line",
        "type": "dialogue",
